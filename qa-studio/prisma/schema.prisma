// Prisma schema for QA Automation Test Studio
// Uses Postgres (Supabase/Neon free tier) for both local dev and
// production — one database, no schema drift between environments.
// See README.md for how to get a free connection string.
//
// NOTE: status/category fields are plain Strings rather than Prisma
// `enum` types. This project started on SQLite (which doesn't support
// enums) and kept the same convention after moving to Postgres to avoid
// unnecessary churn — Postgres does support real enums if you want to
// convert these later.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Run {
  id            String     @id @default(cuid())
  sourceAUrl    String
  sourceBUrl    String
  status        String     @default("PENDING") // PENDING | RUNNING | COMPLETED | FAILED
  successRate   Float?     // 0–100, computed after completion
  totalDuration Int?       // milliseconds
  errorMessage  String?
  createdAt     DateTime   @default(now())
  completedAt   DateTime?

  testCases     TestCase[]
}

model TestCase {
  id             String   @id @default(cuid())
  runId          String
  run            Run      @relation(fields: [runId], references: [id], onDelete: Cascade)

  category       String   // FUNCTIONAL | UI
  title          String
  expectedResult String
  actualResult   String
  status         String   // PASS | FAIL
  durationMs     Int
  errorDetail    String?  // stack trace / diff info if failed

  // Visual/UI test fields — only populated for category = "UI"
  viewport         String? // "desktop" | "tablet" | "mobile"
  screenshotAUrl   String? // path under /public, e.g. /runs/{runId}/desktop-a.png
  screenshotBUrl   String?
  diffImageUrl     String? // pixel-diff overlay image
  diffPercent      Float?  // % of pixels that differ

  createdAt      DateTime @default(now())
}
